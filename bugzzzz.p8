pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
plx =44
ply =23
speed =2


--  for animation
anim_timer = 0
    current_spr = 1
end



function _update()
--player movement
if (btn(⬅️))  plx -= speed
if (btn(➡️))  plx += speed

-- to keep the player inside--
if (plx < 0) plx = 0
if (plx > 120) plx = 120


anim_timer += 1
    if anim_timer % 4 == 0 then
        if current_spr == 1 then
            current_spr = 2
        else
            current_spr = 1
        end
    end
end



function _draw()
cls(0)

--fliping the spirit if 
-- its right or left--
local flip = false
if btn(⬅️) then
        flip = true
    end
    
-- drawing the spirit--
-- screen size is 16*8
map(43, 20, 0, 0, 16, 8)
spr(current_spr, plx, ply, 1, 1, flip)



end
