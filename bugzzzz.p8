pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
    plx = 44
    ply = 23
    speed = 2

    sleeper_x = 48
    sleeper_y = 23

    anim_timer = 0
    current_spr = 1

    annoy_level = 0
    max_annoy = 100
    is_annoying = false
    speed_of_annoy = 2

    game_won = false
end

function update_player()
    if (btn(⬅️)) plx -= speed
    if (btn(➡️)) plx += speed

    if (plx < 0) plx = 0
    if (plx > 120) plx = 120

    anim_timer += 1
    if anim_timer % 4 == 0 then
        if current_spr == 1 then
            current_spr = 2
        else
            current_spr = 1
        end
    end
end

function update_annoyance()
    local is_near = abs(plx - sleeper_x) < 14 and abs(ply - sleeper_y) < 20

    if is_near and btn(❎) then
        if not is_annoying then
            sfx(0)
        end
        is_annoying = true

        if annoy_level < max_annoy then
            annoy_level += speed_of_annoy
            if annoy_level >= max_annoy then
                annoy_level = max_annoy
                sfx(1)
                game_won = true
            end
        end
    else
        is_annoying = false
    end
end

function draw_map()
    map(43, 20, 0, 0, 16, 8)
end

function draw_player()
    local flip = false
    if btn(⬅️) then
        flip = true
    end
    spr(current_spr, plx, ply, 1, 1, flip)

    if is_annoying and not game_won then
        print("zzz!", plx + 6, ply - 5, 10)
    end
end

function draw_annoy_bar()
    local bar_x = 4
    local bar_y = 4
    local max_width = 6
    local current_width = (annoy_level / max_annoy) * max_width
    if current_width > 0 then
        rectfill(bar_x + 1, bar_y + 2, bar_x + 1 + current_width, bar_y + 5, 8)
    end

    spr(32, bar_x, bar_y)
end

function draw_win_screen()
    rectfill(16, 35, 112, 85, 0)
    rect(15, 34, 113, 86, 7)
    print("you win!", 48, 45, 10)
    print("play again?", 42, 58, 7)
    print("press z", 48, 70, 6)
end

function _update()
    if game_won then
        if btnp(🅾️) then
            _init()
        end
    else
        update_player()
        update_annoyance()
    end
end

function _draw()
    cls(0)

    draw_map()
    draw_player()
    draw_annoy_bar()

    if game_won then
        draw_win_screen()
    end
end
